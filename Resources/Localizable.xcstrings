    "iPhone 直接连接，连不上时用 Mac 中转": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connects directly, falls back to the Mac relay"
          }
        },
        "zh-Hans": {
